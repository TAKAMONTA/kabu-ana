rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /subscriptions/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // ウォッチリスト: 本人のみ読み取り可。
    // 書き込みは Admin SDK（/api/watchlist）経由に限定し、
    // クライアントからの直接書き込みを禁止する
    // （無料プランの上限をサーバー側でのみ強制するため）。
    match /users/{userId}/watchlist/{code} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    match /signals_prices/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    match /signals_news/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    match /signals_seismic/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    match /signals_baseline/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    match /signals_risk/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    match /signals_brief/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    match /signals_run_log/{document=**} {
      allow read, write: if false;
    }

    match /signals_claude_log/{document=**} {
      allow read, write: if false;
    }

    match /signals_claude_usage/{document=**} {
      allow read, write: if false;
    }
  }
}
