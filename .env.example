# OpenRouter API (AI分析に必須)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# AIバンドルトークンの署名鍵（未設定時は OPENROUTER_API_KEY にフォールバック）
AI_BUNDLE_TOKEN_SECRET=your_ai_bundle_token_secret_here

# 市場データ: 既定で日本株=J-Quants / 米国株=Twelve Data の自動振り分け
# J-Quants V2 (日本株。ダッシュボードで発行する APIキー)
JQUANTS_API_KEY=your_jquants_api_key_here
# Twelve Data (米国株。無料枠 800req/日)
TWELVE_DATA_API_KEY=your_twelvedata_api_key_here

# Firebase (認証・データベース)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"..."}

# Lemon Squeezy (課金)
LEMON_SQUEEZY_API_KEY=your_lemon_squeezy_api_key_here
LEMON_SQUEEZY_STORE_ID=your_store_id
LEMON_SQUEEZY_VARIANT_ID_MONTHLY=your_monthly_variant_id
LEMON_SQUEEZY_VARIANT_ID_YEARLY=your_yearly_variant_id
# 買い切り（期限なしのプレミアム）を販売する場合のみ設定（任意）。
# 未設定なら order_created で期限なしのプレミアムを付与しない
# LEMON_SQUEEZY_VARIANT_ID_LIFETIME=your_lifetime_variant_id
# Webhook 署名検証 (本番必須)
LEMON_SQUEEZY_WEBHOOK_SECRET=your_webhook_secret_here

# App Store Server API (iOS アプリ内課金のサーバー検証)
APP_STORE_CONNECT_KEY_ID=your_app_store_connect_key_id
APP_STORE_CONNECT_ISSUER_ID=your_app_store_connect_issuer_id
APP_STORE_CONNECT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
IOS_BUNDLE_ID=com.takaapps.kabunavi
IOS_SUBSCRIPTION_PRODUCT_IDS=com.takaapps.kabunavi.Monthly,com.takaapps.kabunavi.Yearly
# App Store Server Notifications v2（/api/apple/notifications）。App Store Connect の App 情報の Apple ID（数字）
APP_STORE_APP_APPLE_ID=your_app_apple_id

# Google Play Developer API (Android アプリ内課金のサーバー検証)
GOOGLE_PLAY_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"..."}
GOOGLE_PLAY_PACKAGE_NAME=app.vercel.kabu_9t7mdgybz_takamontas_projects.twa
ANDROID_SUBSCRIPTION_PRODUCT_IDS=premium_monthly,premium_yearly
# Google Play RTDN（/api/google/rtdn）の Pub/Sub push 認証。手順は docs/store-server-notifications.md
GOOGLE_RTDN_PUSH_AUDIENCE=https://kabu-ana.com/api/google/rtdn
GOOGLE_RTDN_PUSH_SERVICE_ACCOUNT_EMAIL=rtdn-push@your-project.iam.gserviceaccount.com
# Android ビルド用アプリケーションID (GOOGLE_PLAY_PACKAGE_NAME 未設定時のフォールバック)
ANDROID_APPLICATION_ID=com.takaapps.kabunavi

# Android release signing (ローカル/CI ビルド用。実値はコミットしない)
ANDROID_KEYSTORE_FILE=/absolute/path/to/upload-keystore.jks
ANDROID_KEYSTORE_PASSWORD=your_secure_store_password
ANDROID_KEY_ALIAS=upload
ANDROID_KEY_PASSWORD=your_secure_key_password

# App URL
NEXT_PUBLIC_APP_URL=https://kabu-ana.com

# Capacitor 向け静的エクスポートビルド時に true（Next.js APIルートを無効化）
EXPORT_STATIC=false

# ===== Market Signals (新規タブ /signals 用) =====
# EIA Open Data API (WTI / Brent / 天然ガス / ガソリン在庫)
# 登録: https://www.eia.gov/opendata/register.php (無料)
EIA_API_KEY=your_eia_api_key_here

# FRED API (VIX / USDインデックス / 米10年金利)
# 登録: https://fred.stlouisfed.org/docs/api/api_key.html (無料)
FRED_API_KEY=your_fred_api_key_here

# Vercel Cron 認証用シークレット（/api/signals/cron/refresh）
# Vercel は CRON_SECRET（この名前固定）の値を Authorization: Bearer <値> として
# cron 実行時に自動送信する。Vercel のプロジェクト環境変数に設定すること。
# 生成: openssl rand -hex 32
CRON_SECRET=your_random_64_char_hex_here
# 旧名（互換のため引き続き受け付ける。新規設定は CRON_SECRET を使う）
# SIGNALS_CRON_SECRET=your_random_64_char_hex_here

# EDINET DB API（日本企業の財務指標・有報データ。未設定時はエンリッチメントをスキップして動作）
EDINETDB_API_KEY=your_edinetdb_api_key_here
